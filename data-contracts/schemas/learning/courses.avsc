{
  "type": "record",
  "name": "Course",
  "namespace": "com.sentpul.learning",
  "doc": "One free course, module or learning path from an openly accessible catalogue (e.g. 'Introduction to Kubernetes' on Microsoft Learn). The learning-path feature joins these to the canonical skills extracted from job postings, so this is the course side of that join and holds no skills of its own — matching happens downstream in reverse_etl, where the skill dictionary lives.",
  "fields": [
    {
      "name": "id",
      "type": "string",
      "doc": "SHA-256 hex digest of url. Stable dedup key: ReplacingMergeTree orders by it, so re-crawling a course replaces its row instead of adding one. A course's url IS its identity — providers reuse titles across levels and locales."
    },
    {
      "name": "source",
      "type": "string",
      "doc": "Catalogue this record was fetched from: 'mslearn', 'mitlearn' or 'freecodecamp'. One value per fetcher in api_crawler/jobs/courses/source.py, so a source can be retired or re-crawled on its own."
    },
    {
      "name": "provider",
      "type": "string",
      "doc": "Who teaches it, as the catalogue names them. E.g. 'Microsoft Learn', 'MIT OpenCourseWare', 'MITx', 'freeCodeCamp'. Distinct from source: MIT Learn's one API serves several providers."
    },
    {
      "name": "title",
      "type": "string",
      "doc": "Course title as published. E.g. 'Implement security controls for Azure Kubernetes Service'."
    },
    {
      "name": "url",
      "type": "string",
      "doc": "Canonical link to the course, with provider tracking parameters stripped. This is the whole product: the feature links out and never hosts content."
    },
    {
      "name": "summary",
      "type": ["null", "string"],
      "default": null,
      "doc": "The provider's own blurb. Carried into the raw zone ONLY because the downstream skill matcher needs text to scan; it is dropped when the public catalogue is built, so the app never redistributes a provider's description. Null when the catalogue publishes none."
    },
    {
      "name": "tags",
      "type": {"type": "array", "items": "string"},
      "default": [],
      "doc": "The catalogue's own labels — Microsoft products and roles, MIT topics — with hyphens turned into spaces so the skill extractor can scan them as words. Never promoted to skills on their own: an unknown tag is dropped, the same decision the job pipeline records for tech_stack."
    },
    {
      "name": "language",
      "type": "string",
      "default": "en",
      "doc": "ISO-639-1 language of instruction. Tracked because this is a Vietnamese market and 'vi' is the scarcest, most valuable attribute a course can have — every row crawled so far is 'en', which is what the hand-curation list exists to fix."
    },
    {
      "name": "is_free",
      "type": "boolean",
      "default": true,
      "doc": "True when the course can be taken at no cost. Only free courses are crawled, so this is always true today; the field exists so a paid catalogue can land in the same table without a schema change."
    },
    {
      "name": "level",
      "type": {
        "type": "enum",
        "name": "CourseLevel",
        "doc": "How much the course assumes.",
        "symbols": ["INTRO", "WORKING", "DEEP", "UNKNOWN"]
      },
      "default": "UNKNOWN",
      "doc": "Difficulty band, mapped from the catalogue's own label (Microsoft's beginner/intermediate/advanced). UNKNOWN when the catalogue states none — never inferred from the title, because a wrong level puts a course at the wrong step of a path."
    },
    {
      "name": "duration_minutes",
      "type": ["null", "int"],
      "default": null,
      "doc": "Stated duration in minutes, SOURCE-PROVIDED only. Microsoft publishes this; MIT does not -- it publishes weeks plus a weekly commitment, which this int cannot hold, so MIT rows carry duration_text, duration_weeks_min and weekly_hours_min instead and leave this null. freeCodeCamp publishes no duration at all. Orders courses within one path step, shortest first -- but ONLY within a single content_kind, since a learning path contains the modules it would be compared against."
    },
    {
      "name": "license_cc",
      "type": ["null", "boolean"],
      "default": null,
      "doc": "True when the provider marks the material Creative Commons (MIT Learn reports this). Null when the catalogue says nothing — absence is not permission, so a null here means 'ask before reusing anything but the link'."
    },
    {
      "name": "crawled_at",
      "type": "string",
      "default": "",
      "doc": "ISO-8601 UTC timestamp of this fetch, e.g. '2026-10-31T02:15:30Z'. Version column for the silver layer: keep the latest crawled_at per id. Also the staleness clock — a course nobody has re-seen in months is a dead-link candidate."
    },
    {
      "name": "uid",
      "type": ["null", "string"],
      "default": null,
      "doc": "The catalogue's own identifier (Microsoft `uid`, e.g. 'learn.languages.fsharp-first-steps'). Null where the source publishes none -- freeCodeCamp rows are synthesised from filenames and have no id but their url. Hierarchy is expressed in these uids, not in `id`, which is a hash of the url and is ours, not the source's."
    },
    {
      "name": "content_kind",
      "type": {
        "type": "enum",
        "name": "CourseContentKind",
        "doc": "What kind of thing this row is. Read from the catalogue's own `type` field, never inferred.",
        "symbols": ["LEARNING_PATH", "MODULE", "COURSE", "UNKNOWN"]
      },
      "default": "UNKNOWN",
      "doc": "LEARNING_PATH is an ordered container of MODULEs; a MODULE is an ordered container of units; COURSE is a standalone item (MIT, freeCodeCamp). Microsoft publishes `type` ('module'/'learningPath') and this is a direct read of it -- a learning path must never be ranked as an ordinary module, and `duration_minutes` is not comparable across kinds (a 102-minute path CONTAINS 65-minute modules)."
    },
    {
      "name": "child_uids",
      "type": {"type": "array", "items": "string"},
      "default": [],
      "doc": "ORDERED child uids: a learning path's modules, or a module's units. Position IS the sequence -- index 0 is step 1. This is the only curriculum ordering any source gives us, so it is stored verbatim and never sorted. Empty for COURSE rows and for anything with no children."
    },
    {
      "name": "child_count",
      "type": ["null", "int"],
      "default": null,
      "doc": "The source's own `number_of_children`. Kept precisely so incomplete hierarchy is DETECTABLE: when this exceeds len(child_uids), or a child uid is absent from the crawl, the hierarchy is partial. Paging and max_pages guarantee that happens. Never reconcile the two -- a disagreement is the signal."
    },
    {
      "name": "first_child_url",
      "type": ["null", "string"],
      "default": null,
      "doc": "Source `firstModuleUrl` (paths) or `firstUnitUrl` (modules): where a learner actually starts. Units are NOT crawlable entities -- the catalogue exposes no units array, only uid references -- so this is the only unit-level url that exists."
    },
    {
      "name": "parent_uids",
      "type": {"type": "array", "items": "string"},
      "default": [],
      "doc": "Containers that list this row in their children, resolved ONLY against uids present in the same crawl. A module whose path was not crawled keeps an empty list: that is honest, where a guessed parent would not be. Not ordered and not a step index -- a module can sit at position 2 of one path and 5 of another, so its position lives in the parent's child_uids, not here."
    },
    {
      "name": "duration_text",
      "type": ["null", "string"],
      "default": null,
      "doc": "The source's duration string exactly as published, e.g. '6 weeks' or '5 hours/week'. Display and audit only; never parsed for ranking."
    },
    {
      "name": "duration_weeks_min",
      "type": ["null", "int"],
      "default": null,
      "doc": "Source `min_weeks` (MIT). A calendar span, NOT effort, and not convertible to minutes without assuming a study rate the source never states."
    },
    {
      "name": "weekly_hours_min",
      "type": ["null", "int"],
      "default": null,
      "doc": "Source `min_weekly_hours` (MIT). Effort per week; combine with duration_weeks_min only as an explicit, labelled estimate."
    },
    {
      "name": "duration_is_derived",
      "type": "boolean",
      "default": false,
      "doc": "False means every duration field above came from the source. No estimates are produced today, so this is False on every row; it exists so a future derived value can never be mistaken for a published one."
    }
  ]
}
